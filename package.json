{
  "name": "@gorth/structure",
  "version": "3.1.4",
  "description": "",
  "type": "module",
  "author": "Gorthenburg",
  "license": "GORTH",
  "private": true,
  "keywords": [
    "gorth",
    "supabase",
    "ably",
    "postgres",
    "graphql",
    "better-auth"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goraria/base-structure.git"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "import": "./dist/lib/*.js",
      "require": "./dist/lib/*.cjs"
    },
    "./modules/*": {
      "types": "./dist/modules/*.d.ts",
      "import": "./dist/modules/*.js",
      "require": "./dist/modules/*.cjs"
    },
    "./modules/*/*": {
      "types": "./dist/modules/*/*.d.ts",
      "import": "./dist/modules/*/*.js",
      "require": "./dist/modules/*/*.cjs"
    },
    "./modules/*/*/*": {
      "types": "./dist/modules/*/*/*.d.ts",
      "import": "./dist/modules/*/*/*.js",
      "require": "./dist/modules/*/*/*.cjs"
    },
    "./cores/*": {
      "types": "./dist/cores/*.d.ts",
      "import": "./dist/cores/*.js",
      "require": "./dist/cores/*.cjs"
    },
    "./cores/*/*": {
      "types": "./dist/cores/*/*.d.ts",
      "import": "./dist/cores/*/*.js",
      "require": "./dist/cores/*/*.cjs"
    },
    "./cores/*/*/*": {
      "types": "./dist/cores/*/*/*.d.ts",
      "import": "./dist/cores/*/*/*.js",
      "require": "./dist/cores/*/*/*.cjs"
    }
  },
  "typesVersions": {
    "*": {
      "cores/*": [
        "dist/cores/*.d.ts"
      ],
      "cores/*/*": [
        "dist/cores/*/*.d.ts"
      ],
      "cores/*/*/*": [
        "dist/cores/*/*/*.d.ts"
      ],
      "common/*": [
        "dist/common/*.d.ts"
      ],
      "*": [
        "dist/index.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown --minify",
    "prepack": "pnpm build",
    "dev": "tsdown --format esm,cjs --dts --out-dir dist --watch",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "update": "pnpm update",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "@ably/ai-transport": "^0.9.0",
    "@ably/chat": "^1.4.0",
    "@ably/spaces": "^0.5.2",
    "@better-auth/infra": "^0.4.14",
    "@better-auth/oauth-provider": "^1.7.7",
    "@better-auth/scim": "^1.7.7",
    "@better-auth/sso": "^1.7.7",
    "@better-auth/stripe": "^1.7.7",
    "@supabase/postgrest-js": "^2.117.2",
    "@supabase/server": "^1.9.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "ably": "^2.29.0",
    "axios": "^1.20.0",
    "better-auth": "^1.7.7",
    "graphql": "^17.0.2",
    "graphql-request": "^7.4.0",
    "graphql-tag": "^2.12.7",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "postgres": "^3.4.9",
    "svix": "^2.7.0",
    "tsx": "^4.23.15",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "prettier": "^3.9.9",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.33.4"
}
